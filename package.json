{
  "name": "packet-eye-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b",
    "fetch-geoip": "powershell -ExecutionPolicy Bypass -File scripts/fetch-geoip.ps1",
    "fetch-threats": "powershell -ExecutionPolicy Bypass -File scripts/fetch-threats.ps1",
    "agent:run": "powershell -ExecutionPolicy Bypass -File scripts/cargo.ps1 run --manifest-path agent/Cargo.toml",
    "agent:build": "powershell -ExecutionPolicy Bypass -File scripts/cargo.ps1 build --release --manifest-path agent/Cargo.toml",
    "agent:check": "powershell -ExecutionPolicy Bypass -File scripts/cargo.ps1 check --manifest-path agent/Cargo.toml"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^0.460.0",
    "postprocessing": "6.36",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
